{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmbcapotas",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
}
